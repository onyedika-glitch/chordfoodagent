# Chord (from your Chord account / TSG contact)
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_TEAMMATE_ID=
CHORD_MCP_SERVER_ID=

# Paystack TEST secret key. The server refuses sk_live_ keys.
PAYSTACK_SECRET_KEY=sk_test_

# Shared secret Chord sends as "Authorization: Bearer ..." to the MCP server.
# Generate: openssl rand -hex 24
MCP_TOKEN=
# Public URL Chord calls, e.g. https://mamatee.example.com/mcp
MCP_PUBLIC_URL=
# Password for https://<domain>/kitchen (any username)
KITCHEN_PASSWORD=

# Optional
# PAYMENT_CALLBACK_URL=https://wa.me/   # where Paystack sends the customer after paying
# SOLD_OUT=poundo-egusi                 # comma-separated item ids
# ALWAYS_OPEN=1                         # ignore opening hours (for reviewers testing at night)
